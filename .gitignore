.DS_Store

# Raw source material — capture originals, the PDF source, extracted figure
# scratch. Far too large for git (several .mov files exceed GitHub's 100 MB
# limit). Everything the site actually serves lives in static/.
media/

# Paper is not public yet.
static/EgoIntercept.pdf

# Raw supplementary capture (~200 MB). The site serves the 2x re-encode at
# static/vids/overview-2x.mp4; rebuild it with tools/make-overview.sh.
IcraSupplement.mov

# Unlabeled simulation render. The site serves the labeled version at
# static/vids/sim/; rebuild it with tools/label-sim-rollout.sh.
sim_rollout.mp4

# Onboard-view captures. Archived under media/vids/onboard/; the site
# serves the faststart remuxes at static/vids/onboard-view-*.mp4.
onboard_view*.mp4
